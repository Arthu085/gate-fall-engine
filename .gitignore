# --- GateFall ---------------------------------------------------------------

# Datasets brutos, anotações baixadas e features derivadas nunca são
# versionados (ver docs/data/organization.md).
data/raw/*
!data/raw/.gitkeep
data/labels/*
!data/labels/.gitkeep
data/features/*
!data/features/.gitkeep
data/scratch/*
!data/scratch/.gitkeep
data/manifest.parquet

# Mídia e arquivos de dados binários
*.mp4
*.avi
*.zip
*.h5
*.hdf5
*.npy
*.npz

# Pesos e checkpoints
*.pt
*.pth
checkpoints/

# Saídas de execução, tracking e build da documentação: runs/baseline_a/config.yaml
# e runs/baseline_a/metrics.json são versionados como resultado reproduzível;
# checkpoints (*.pt) já ficam de fora pela regra global acima.
runs/*
!runs/baseline_a/
runs/baseline_a/*
!runs/baseline_a/config.yaml
!runs/baseline_a/metrics.json
outputs/
wandb/
site/

# Documentação
docs/tasks